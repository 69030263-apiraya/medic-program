<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ระบบตั้งค่าโปรแกรม (Settings Module)</title>
  
  <!-- Tailwind CSS สำหรับจัดสไตล์ UI -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
    }
  </script>
</head>
<body class="bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-100 transition-colors duration-300 min-h-screen p-4 sm:p-8 flex items-center justify-center">

  <div class="w-full max-w-md bg-white dark:bg-gray-800 p-6 sm:p-8 rounded-2xl shadow-xl border border-gray-200 dark:border-gray-700 space-y-6">
    
    <!-- ส่วนหัวข้อ -->
    <header class="text-center space-y-1">
      <h1 class="text-2xl sm:text-3xl font-bold text-blue-600 dark:text-blue-400 flex items-center justify-center gap-2">
        ⚙️ ตั้งค่าระบบ
      </h1>
      <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400">ปรับแต่งการทำงานและบันทึก Local Config</p>
    </header>

    <div class="space-y-5">
      <!-- 1. ปุ่มสลับ Dark / Light Mode -->
      <div class="flex items-center justify-between p-3.5 bg-gray-50 dark:bg-gray-700/50 rounded-xl border border-gray-200 dark:border-gray-600">
        <div>
          <p class="font-semibold text-sm sm:text-base">ธีมหน้าจอ</p>
          <p class="text-xs text-gray-500 dark:text-gray-400">เลือกโหมดสว่างหรือโหมดมืด</p>
        </div>
        <button id="themeToggleBtn" class="px-3.5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs sm:text-sm font-medium transition shadow-sm flex items-center gap-1.5">
          ☀️ <span id="themeBtnText">Light Mode</span>
        </button>
      </div>

      <!-- 2. แถบปรับระดับเสียงเตือน พร้อมปุ่มเล่นเสียงตัวอย่าง -->
      <div class="p-4 bg-gray-50 dark:bg-gray-700/50 rounded-xl border border-gray-200 dark:border-gray-600 space-y-3">
        <div class="flex justify-between items-center text-sm font-semibold">
          <label for="volumeRange" class="flex items-center gap-1.5">
            🔔 ระดับเสียงเตือน
          </label>
          <span id="volumeVal" class="text-blue-600 dark:text-blue-400 font-bold">80%</span>
        </div>
        
        <input type="range" id="volumeRange" min="0" max="100" value="80" class="w-full accent-blue-600 cursor-pointer h-2 bg-gray-200 rounded-lg dark:bg-gray-600">
        
        <div class="flex justify-end pt-1">
          <button id="testAudioBtn" class="px-3 py-1.5 bg-gray-200 dark:bg-gray-600 hover:bg-gray-300 dark:hover:bg-gray-500 text-gray-700 dark:text-gray-200 rounded-lg text-xs font-medium transition flex items-center gap-1">
            ▶️ ทดลองฟังเสียง
          </button>
        </div>
      </div>

      <!-- 3. ช่องกรอก LINE Notify Token -->
      <div class="p-4 bg-gray-50 dark:bg-gray-700/50 rounded-xl border border-gray-200 dark:border-gray-600 space-y-2">
        <label for="lineToken" class="block text-sm font-semibold flex items-center gap-1.5">
          💬 LINE Notify Token
        </label>
        <input type="text" id="lineToken" placeholder="วาง Token สำหรับแจ้งเตือนที่นี่..." class="w-full px-3.5 py-2.5 text-sm border rounded-lg bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500 transition">
        <p class="text-xs text-gray-400 dark:text-gray-500">รับ Token ได้จากเว็บไซต์ LINE Notify</p>
      </div>

      <!-- 4. ปุ่มบันทึก Local Config -->
      <button id="saveConfigBtn" class="w-full py-3 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-xl transition shadow-md flex items-center justify-center gap-2 text-sm sm:text-base">
        💾 บันทึกการตั้งค่า (Save Config)
      </button>
    </div>

  </div>

  <script>
    const themeToggleBtn = document.getElementById('themeToggleBtn');
    const themeBtnText = document.getElementById('themeBtnText');
    const volumeRange = document.getElementById('volumeRange');
    const volumeVal = document.getElementById('volumeVal');
    const testAudioBtn = document.getElementById('testAudioBtn');
    const lineToken = document.getElementById('lineToken');
    const saveConfigBtn = document.getElementById('saveConfigBtn');

    function playBeep(volumePercent) {
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const oscillator = audioCtx.createOscillator();
        const gainNode = audioCtx.createGain();

        oscillator.type = 'sine';
        oscillator.frequency.setValueAtTime(880, audioCtx.currentTime);
        
        const gainValue = (volumePercent / 100) * 0.5;
        gainNode.gain.setValueAtTime(gainValue, audioCtx.currentTime);

        oscillator.connect(gainNode);
        gainNode.connect(audioCtx.destination);

        oscillator.start();
        oscillator.stop(audioCtx.currentTime + 0.25);
      } catch (e) {
        console.log('Audio Context Error:', e);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const savedConfig = JSON.parse(localStorage.getItem('userConfig')) || {
        theme: 'light',
        volume: 80,
        lineToken: ''
      };

      applyTheme(savedConfig.theme);
      volumeRange.value = savedConfig.volume;
      volumeVal.textContent = savedConfig.volume + '%';
      lineToken.value = savedConfig.lineToken;
    });

    volumeRange.addEventListener('input', (e) => {
      volumeVal.textContent = e.target.value + '%';
    });

    testAudioBtn.addEventListener('click', () => {
      playBeep(volumeRange.value);
    });

    themeToggleBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      applyTheme(isDark ? 'light' : 'dark');
    });

    function applyTheme(theme) {
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
        themeBtnText.textContent = 'Dark Mode';
        themeToggleBtn.className = "px-3.5 py-2 bg-gray-700 hover:bg-gray-600 text-yellow-300 rounded-lg text-xs sm:text-sm font-medium transition shadow-sm flex items-center gap-1.5";
      } else {
        document.documentElement.classList.remove('dark');
        themeBtnText.textContent = 'Light Mode';
        themeToggleBtn.className = "px-3.5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs sm:text-sm font-medium transition shadow-sm flex items-center gap-1.5";
      }
    }

    saveConfigBtn.addEventListener('click', () => {
      const config = {
        theme: document.documentElement.classList.contains('dark') ? 'dark' : 'light',
        volume: volumeRange.value,
        lineToken: lineToken.value
      };

      localStorage.setItem('userConfig', JSON.stringify(config));
      playBeep(volumeRange.value);
      alert('💾 บันทึกการตั้งค่าลง Local Config เรียบร้อยแล้ว!');
    });
  </script>
</body>
</html>